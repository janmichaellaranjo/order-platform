build/
**/build/
out/
**/out/
target/
**/target/
bin/
**/bin/
!**/src/**/bin/

# Ignore Gradle GUI config
gradle-app.setting

# Avoid ignoring Gradle wrapper jar file (keep it committed)
!gradle/wrapper/gradle-wrapper.jar

